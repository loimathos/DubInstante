/* ========================================================================= */
/* style.qss - DubInstante 2026 Light UI — Purple-led Design System         */
/* ========================================================================= */

/* Tokens (from dubinstante-design-system)
   bg:             #fafafb  (neutral-50)
   surface:        #ffffff  (neutral-0)
   surface-sunk:   #f4f4f6  (neutral-100)
   surface-hover:  #f4f4f6  (neutral-100)
   fg1:            #121217  (neutral-900)
   fg2:            #3a3a42  (neutral-700)
   fg3:            #7a7a85  (neutral-500)
   fg4:            #a8a8b2  (neutral-400)
   border:         #e9e9ed  (neutral-200)
   border-strong:  #d6d6dc  (neutral-300)
   border-focus:   #7c56f5  (purple-500)
   accent:         #7c56f5  (purple-500)
   accent-hover:   #6838e0  (purple-600)
   accent-press:   #5627bb  (purple-700)
   accent-soft:    #f6f3ff  (purple-50)
   accent-soft-2:  #ece4ff  (purple-100)
   on-accent:      #ffffff
   danger:         #e2344d
   danger-bg:      #fde6ea
   success:        #0ea66b
   warning:        #d98b00
*/

QWidget {
    font-family: "Inter Tight", "Segoe UI", "SF Pro Text", sans-serif;
    color: #121217;
}

QMainWindow,
QWidget#CentralWidget {
    background-color: #fafafb;
}

/* Top menu */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #fafafb,
                                stop:1 #f4f4f6);
    border: none;
    border-bottom: 1px solid #e9e9ed;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #3a3a42;
}

QMenuBar::item {
    background: transparent;
    color: #3a3a42;
    padding: 6px 11px;
    margin: 0 2px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background: #f4f4f6;
    color: #121217;
}

QMenuBar::item:pressed {
    background: #e9e9ed;
    color: #121217;
}

QMenuBar#rightMenuBar {
    background: transparent;
    border: none;
    padding: 0;
}

QMenuBar#rightMenuBar::item {
    color: #7a7a85;
    padding: 6px 10px;
    margin: 0;
    border-radius: 8px;
}

QMenuBar#rightMenuBar::item:selected {
    background: #f4f4f6;
    color: #121217;
}

QMenu {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #f6f3ff;
    color: #5627bb;
}

QMenu::separator {
    height: 1px;
    background: #e9e9ed;
    margin: 4px 2px;
}

QMenu QWidget {
    background: #ffffff;
    color: #121217;
}

QMenu QLabel {
    background: transparent;
    color: #7a7a85;
}

QMenu QPushButton {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 28px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
}

QMenu QPushButton:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
}

QMenu QPushButton:pressed {
    background: #e9e9ed;
}

QWidget#accountPanel {
    background: #ffffff;
}

QLineEdit#accountEmailInput,
QLineEdit#accountPasswordInput {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 28px;
    padding: 4px 10px;
}

QLineEdit#accountEmailInput:focus,
QLineEdit#accountPasswordInput:focus {
    border: 1px solid #7c56f5;
}

QPushButton#accountLoginButton {
    background: #7c56f5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    min-height: 30px;
    padding: 6px 12px;
    font-weight: 600;
}

QPushButton#accountLoginButton:hover {
    background: #6838e0;
}

QPushButton#accountLoginButton:pressed {
    background: #5627bb;
}

/* Video area remains neutral and untouched structurally */
QFrame#videoFrame {
    background-color: #000000;
    border: none;
}

/* Control panel */
QWidget#controlBar {
    background-color: #ffffff;
    border: none;
    border-radius: 10px;
}

QWidget#controlBar QLabel {
    background: transparent;
    color: #3a3a42;
    font-size: 12px;
    font-weight: 500;
}

QLabel#timecodeLabel {
    font-family: "JetBrains Mono", "Consolas", monospace;
    color: #7c56f5;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QLabel[cssClass="control-label"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
}

/* Buttons: no hard borders on control surfaces */
QWidget#controlBar QPushButton,
QFrame[cssClass="track"] QPushButton {
    border: none;
    background: transparent;
    color: #3a3a42;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 600;
}

QWidget#controlBar QPushButton[class="btn"] {
    background: transparent;
    color: #3a3a42;
}

QWidget#controlBar QPushButton[class="btn"]:hover {
    background: #f4f4f6;
}

QWidget#controlBar QPushButton[class="btn"]:pressed {
    background: #e9e9ed;
}

QWidget#controlBar QPushButton[cssClass="stepButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 0;
    font-size: 16px;
    font-weight: 700;
    min-width: 28px;
}

QWidget#controlBar QPushButton[cssClass="stepButton"]:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
    color: #121217;
}

QWidget#controlBar QPushButton[cssClass="stepButton"]:pressed {
    background: #e9e9ed;
}

QWidget#controlBar QPushButton[cssClass="resetButton"] {
    background: #ece4ff;
    color: #5627bb;
    border: 1px solid #d9ccff;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
}

QWidget#controlBar QPushButton[cssClass="resetButton"]:hover {
    background: #d9ccff;
    border: 1px solid #bca7ff;
}

QWidget#controlBar QPushButton[cssClass="iconButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 3px;
}

QWidget#controlBar QPushButton[cssClass="iconButton"]:hover {
    background: #f4f4f6;
    border: 1px solid #d6d6dc;
}

QWidget#controlBar QPushButton#volumeMuteButton:checked {
    background: #fde6ea;
    border: 1px solid #e2344d;
}

QWidget#controlBar QPushButton#btnPlay,
QWidget#controlBar QPushButton#btnPause {
    background: #121217;
    color: #ffffff;
    border-radius: 10px;
    padding: 9px 14px;
}

QWidget#controlBar QPushButton#btnPlay:hover,
QWidget#controlBar QPushButton#btnPause:hover {
    background: #23232a;
}

QWidget#controlBar QPushButton#btnPlay:pressed,
QWidget#controlBar QPushButton#btnPause:pressed {
    background: #3a3a42;
}

QWidget#controlBar QPushButton#btnStop {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #d6d6dc;
    border-radius: 10px;
    padding: 9px 12px;
}

QWidget#controlBar QPushButton#btnStop:hover {
    background: #f4f4f6;
    border: 1px solid #a8a8b2;
}

QWidget#controlBar QPushButton#btnStop:pressed {
    background: #e9e9ed;
}

QWidget#controlBar QPushButton#recordButton {
    background: #fde6ea;
    color: #e2344d;
    border-radius: 8px;
    font-weight: 700;
}

QWidget#controlBar QPushButton#recordButton:hover {
    background: #f9c4cd;
}

QWidget#controlBar QPushButton#recordButton:checked {
    background: #e2344d;
    color: #ffffff;
}

/* Inputs — hide built-in spinbox arrows (custom +/- buttons exist) */
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0;
    border: none;
}

QSpinBox,
QDoubleSpinBox,
QComboBox {
    background: #fafafb;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 26px;
    padding: 3px 10px;
    font-size: 12px;
}

QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border: 1px solid #d6d6dc;
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border: 1px solid #7c56f5;
    background: #ffffff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    selection-background-color: #7c56f5;
    selection-color: #ffffff;
}

QCheckBox {
    color: #7a7a85;
    font-size: 11px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d6d6dc;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:checked {
    background: #7c56f5;
    border: 1px solid #7c56f5;
}

/* Sliders */
QSlider {
    min-height: 18px;
}

QSlider::groove:horizontal {
    border: none;
    background: #e9e9ed;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #7c56f5;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #7c56f5;
    width: 12px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    border: 2px solid #6838e0;
}

/* Mixer area */
QWidget#mixerZone {
    background: transparent;
    border: none;
}

QFrame[cssClass="track"] {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
}

QFrame[cssClass="track"] QLabel[cssClass="track-header-title"] {
    color: #121217;
    font-size: 13px;
    font-weight: 600;
}

QFrame[cssClass="track"] QPushButton[cssClass="track-header-btn"] {
    border: none;
    background: transparent;
    color: #a8a8b2;
    border-radius: 6px;
    padding: 2px;
}

QFrame[cssClass="track"] QPushButton[cssClass="track-header-btn"]:hover {
    background: #f4f4f6;
    color: #7a7a85;
}

QFrame[cssClass="track"] QFrame[cssClass="track-header-line"] {
    background: #e9e9ed;
    min-height: 1px;
    max-height: 1px;
    border: none;
}

QFrame[cssClass="track"] QLabel[cssClass="track-control-label"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
}

QFrame[cssClass="track"] QComboBox[cssClass="track-control-select"] {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    color: #121217;
    font-size: 12px;
    padding: 3px 8px;
}

QFrame[cssClass="track"] QSlider[cssClass="track-control-slider"] {
    min-height: 20px;
}

QFrame[cssClass="track"] QFrame[cssClass="track-vu"] {
    background: #121217;
    border-radius: 6px;
}

QFrame[cssClass="track"] QFrame[cssClass="vu-bg"] {
    background: #23232a;
    border-radius: 3px;
}

QFrame[cssClass="track"] QFrame[cssClass="vu-fill"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0ea66b,
                                stop:0.70 #0ea66b,
                                stop:0.88 #d98b00,
                                stop:1 #e2344d);
    border-radius: 3px;
}

QFrame[cssClass="track"] QLabel[cssClass="color-badge-text"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 500;
}

/* Progress */
QProgressBar {
    border: none;
    border-radius: 6px;
    background: #e9e9ed;
    color: #3a3a42;
    height: 18px;
    text-align: center;
}

QProgressBar::chunk {
    background: #7c56f5;
    border-radius: 6px;
}

/* Track settings dialog & Export Settings Dialog */
QDialog#trackSettingsDialog,
QDialog#exportSettingsDialog {
    background: #fafafb;
}

QDialog#trackSettingsDialog QLabel#settingsDialogTitle,
QDialog#exportSettingsDialog QLabel#settingsDialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: #121217;
}

QDialog#trackSettingsDialog QLabel#settingsDialogSubtitle,
QDialog#exportSettingsDialog QLabel#settingsDialogSubtitle {
    font-size: 12px;
    color: #7a7a85;
    margin-bottom: 2px;
}

QDialog#trackSettingsDialog QFrame#settingsCardTrackSelector,
QDialog#exportSettingsDialog QFrame#settingsCard {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
}

QDialog#trackSettingsDialog QLabel[cssClass="settingsLabel"],
QDialog#exportSettingsDialog QLabel[cssClass="settingsLabel"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
    margin-right: 6px;
}

QDialog#trackSettingsDialog QPushButton[cssClass="trackSelectorButton"] {
    background: #fafafb;
    color: #7a7a85;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QPushButton[cssClass="trackSelectorButton"]:hover {
    background: #f4f4f6;
}

QDialog#trackSettingsDialog QPushButton[cssClass="trackSelectorButton"]:checked {
    background: #ece4ff;
    color: #5627bb;
    border: 1px solid #d9ccff;
}

QDialog#trackSettingsDialog QGroupBox,
QDialog#exportSettingsDialog QGroupBox {
    background: #ffffff;
    border: 1px solid #e9e9ed;
    border-radius: 10px;
    margin-top: 12px;
    font-size: 12px;
    font-weight: 600;
    color: #3a3a42;
}

QDialog#trackSettingsDialog QGroupBox::title,
QDialog#exportSettingsDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    top: 2px;
    padding: 0 6px;
    color: #7a7a85;
    background: #ffffff;
}

QDialog#trackSettingsDialog QPushButton[cssClass="presetButton"] {
    background: #fafafb;
    color: #3a3a42;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QPushButton[cssClass="presetButton"]:hover {
    background: #f4f4f6;
}

QDialog#trackSettingsDialog QPushButton[cssClass="presetButton"]:pressed {
    background: #e9e9ed;
}

QDialog#trackSettingsDialog QLabel[cssClass="fineLabel"],
QDialog#exportSettingsDialog QLabel[cssClass="fineLabel"] {
    color: #7a7a85;
    font-size: 11px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QFontComboBox,
QDialog#trackSettingsDialog QSpinBox,
QDialog#exportSettingsDialog QComboBox,
QDialog#exportSettingsDialog QSpinBox,
QDialog#exportSettingsDialog QLineEdit {
    background: #ffffff;
    color: #121217;
    border: 1px solid #e9e9ed;
    border-radius: 8px;
    min-height: 28px;
    padding: 4px 10px;
}

QDialog#trackSettingsDialog QFontComboBox:hover,
QDialog#trackSettingsDialog QSpinBox:hover,
QDialog#exportSettingsDialog QComboBox:hover,
QDialog#exportSettingsDialog QSpinBox:hover,
QDialog#exportSettingsDialog QLineEdit:hover {
    border: 1px solid #d6d6dc;
}

QDialog#trackSettingsDialog QFontComboBox:focus,
QDialog#trackSettingsDialog QSpinBox:focus,
QDialog#exportSettingsDialog QComboBox:focus,
QDialog#exportSettingsDialog QSpinBox:focus,
QDialog#exportSettingsDialog QLineEdit:focus {
    border: 1px solid #7c56f5;
}

QDialog#trackSettingsDialog QPushButton[cssClass="colorPickerButton"] {
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
}

QDialog#trackSettingsDialog QPushButton#settingsCloseButton {
    background: #7c56f5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 600;
}

QDialog#trackSettingsDialog QPushButton#settingsCloseButton:hover {
    background: #6838e0;
}

QDialog#trackSettingsDialog QPushButton#settingsCloseButton:pressed {
    background: #6c46e0;
}

/* Tab Widget Styling for Export Dialog (Light Theme) */
QTabWidget#expertTabWidget::pane {
    border: 1px solid #e9e9ed;
    border-radius: 10px;
    background: #ffffff;
}

QTabWidget#expertTabWidget QTabBar::tab {
    background: #fafafb;
    color: #7a7a85;
    padding: 6px 12px;
    border: 1px solid #e9e9ed;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    margin-right: 4px;
}

QTabWidget#expertTabWidget QTabBar::tab:selected {
    background: #ffffff;
    color: #5627bb;
    border: 1px solid #e9e9ed;
    border-bottom: 1px solid #ffffff;
}

QTabWidget#expertTabWidget QTabBar::tab:hover:!selected {
    background: #f4f4f6;
    color: #121217;
}

QTabWidget#expertTabWidget QWidget {
    background: #ffffff;
}
